{
  // markdownlint-cli2 configuration.
  //
  // Rule set and line length live in .markdownlint.json (mirrors PyTools).
  //
  // NOTE: this repo has no Jekyll theme files to ignore. Minimal Mistakes is
  // pulled in at build time via `remote_theme`, so there is no vendored
  // _includes/_layouts/_sass to exclude. Every tracked .md file here is our
  // own content and should be linted.
  "ignores": [
    // Local AI agent context, not site content.
    ".claude/**"
  ]
}
